{
  "name": "shri-health-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "front-office",
    "doctors-portal"
  ],
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build -w doctors-portal -w front-office",
    "preview": "vite preview",
    "typecheck": "tsc -b && npm run typecheck -w front-office && tsc -b doctors-portal",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "orval --config orval.config.ts",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "dev:doctors": "npm run dev -w doctors-portal",
    "dev:front-office": "npm run dev -w front-office"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "orval": "8.43.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "framer-motion@13.4.4": {
      "motion-dom": "13.4.4",
      "motion-utils": "13.3.0"
    }
  }
}
