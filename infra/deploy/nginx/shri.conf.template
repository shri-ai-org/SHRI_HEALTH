# The test server's edge (infra/deploy), from infra/nginx/nginx.conf: the same routes and limits,
# with the hostname, public port and certificate from the deploy settings. The nginx image fills
# ${SHRI_HOSTNAME} and ${SHRI_HTTPS_PORT} at start (templates -> conf.d); nginx's own $variables
# are left alone. HTTPS only: port 80 is not published.
#   /api/     -> FastAPI          /hooks/ -> FastAPI (partner callbacks, signed)
#   /health   -> FastAPI          /kc/    -> Keycloak
#   /         -> the front office    /clinician/ -> the doctors' portal (both built into the
#                image; any other path under each gets that app's index.html)
# Behind a shared host's Nginx (deploy.sh, SHRI_PUBLIC_URL) the paths here are the same: the host
# strips its base path (/dep) before it proxies, and the screens are built for it. Then
# SHRI_PUBLIC_PORT is the public one (443), SHRI_HSTS leaves out includeSubDomains (the host's
# other names aren't ours) and SHRI_REAL_IP trusts the client address the host's Nginx gives,
# from the Docker gateway only.
# /ready and /hooks/keycloak/ are never exposed here.

server_tokens off;
client_max_body_size 25m;

log_format no_query '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent"';
# The image's own nginx.conf also logs every request with its query string ("main"). An
# access_log at http level here would only add a second log beside it, so the server below sets
# its own, which replaces every inherited one: the path only, never a query string (download
# tokens, D105; nothing else should carry data in a query, D13). deploy.sh checks it.

limit_req_zone $binary_remote_addr zone=public_forms:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=portal_sign_in:10m rate=30r/m;
limit_req_status 429;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${SHRI_HOSTNAME};

    access_log /dev/stdout no_query;
    absolute_redirect off;  # a redirect stays relative, so the host's base path is kept
    ${SHRI_REAL_IP}

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "${SHRI_HSTS}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Only for the configured host: anything else (a scanner using the IP) gets nothing.
    if ($host != "${SHRI_HOSTNAME}") {
        return 444;
    }

    # All proxy headers at server level (never inside a location: nginx would drop these there).
    proxy_http_version 1.1;
    proxy_set_header Host              $host:${SHRI_PUBLIC_PORT};
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host  $host:${SHRI_PUBLIC_PORT};
    proxy_set_header X-Forwarded-Port  ${SHRI_PUBLIC_PORT};
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    # The development sign-in headers never reach the API from outside (the API refuses them
    # outside development and test anyway; deploy.sh checks both).
    proxy_set_header X-Dev-User          "";
    proxy_set_header X-Dev-Patient       "";
    proxy_set_header X-Dev-Patient-Clinic "";

    location /api/ {
        proxy_pass http://api:8000;
        proxy_buffering off;  # Server-Sent Events
        proxy_read_timeout 1h;
    }

    location ~ ^/api/v1/files/[^/]+/content$ {
        error_log /dev/stderr crit;  # error lines quote the request line, token included
        proxy_pass http://api:8000;
    }

    location ^~ /api/v1/portal/practices/ {
        limit_req zone=public_forms burst=5 nodelay;
        client_max_body_size 64k;
        error_page 429 = @rate_limited;
        proxy_pass http://api:8000;
    }

    location = /api/v1/portal/bot-challenge {
        limit_req zone=public_forms burst=5 nodelay;
        error_page 429 = @rate_limited;
        proxy_pass http://api:8000;
    }

    location ^~ /api/v1/portal/auth/ {
        limit_req zone=portal_sign_in burst=10 nodelay;
        error_page 429 = @rate_limited;
        proxy_pass http://api:8000;
    }

    location = /api/v1/portal/enrollments {
        limit_req zone=portal_sign_in burst=5 nodelay;
        client_max_body_size 4k;
        error_page 429 = @rate_limited;
        proxy_pass http://api:8000;
    }

    location @rate_limited {
        default_type application/problem+json;
        return 429 '{"type":"tag:company-domain.invalid,2026:problem/rate-limited","title":"Too many requests","status":429,"code":"rate-limited"}';
    }

    location = /health {
        proxy_pass http://api:8000;
    }

    location ^~ /hooks/keycloak/ {
        return 404;  # Keycloak calls the API over the internal network
    }

    location /hooks/ {
        client_max_body_size 64k;
        proxy_pass http://api:8000;
    }

    location ^~ /kc/realms/shri-patients/ {
        limit_req zone=portal_sign_in burst=10 nodelay;
        proxy_pass http://keycloak:8080;
        # Keycloak's own sign-in pages run inline scripts: the light/dark switch (without it a
        # dark-mode browser shows light labels on the white card), the double-click guard on the
        # sign-in button and the session check. So script-src allows 'unsafe-inline' here, for
        # Keycloak's pages only; the app keeps the strict policy above. A location with its own
        # add_header inherits none of the server's, so the whole set is repeated.
        add_header Strict-Transport-Security "${SHRI_HSTS}" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
    }

    # Keycloak's admin console stays off the public host: use an SSH tunnel (README).
    location ^~ /kc/admin/ {
        return 404;
    }

    location /kc/ {
        proxy_pass http://keycloak:8080;
        # Keycloak's own sign-in pages run inline scripts: the light/dark switch (without it a
        # dark-mode browser shows light labels on the white card), the double-click guard on the
        # sign-in button and the session check. So script-src allows 'unsafe-inline' here, for
        # Keycloak's pages only; the app keeps the strict policy above. A location with its own
        # add_header inherits none of the server's, so the whole set is repeated.
        add_header Strict-Transport-Security "${SHRI_HSTS}" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
    }

    # The screens (built into this image, nginx/Dockerfile): the front office at /, the doctors'
    # portal at /clinician/. Hashed assets are cached for good; index.html never is, so a new
    # release reaches the browser on the next load. Any other path under an app is one of its
    # screen routes and gets that app's index.html (its router decides).
    location ^~ /clinician/assets/ {
        alias /srv/shri-web/clinician/assets/;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "${SHRI_HSTS}" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri =404;
    }

    location = /clinician {
        return 301 clinician/;
    }

    location ^~ /clinician/ {
        alias /srv/shri-web/clinician/;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "${SHRI_HSTS}" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri /clinician/index.html;
    }

    location ^~ /assets/ {
        root /srv/shri-web/front-office;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "${SHRI_HSTS}" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri =404;
    }

    location / {
        root /srv/shri-web/front-office;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "${SHRI_HSTS}" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri /index.html;
    }
}
