# Copy to infra/compose/.env (git-ignored) and fill in. Local development only.
POSTGRES_DB=shri_health
# Local superuser, standing in for the RDS master role. Never used by the API.
POSTGRES_USER=shri
POSTGRES_PASSWORD=
# One login per service role (DECISIONS D23).
SHRI_MIGRATOR_PASSWORD=
SHRI_APP_PASSWORD=
SHRI_FHIR_READER_PASSWORD=
SHRI_INTEGRATION_PASSWORD=
SHRI_REPORTING_PASSWORD=
SHRI_MAINTENANCE_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# The API's Keycloak client secret (realm shri-staff, client shri-web). Any long random value,
# for example: openssl rand -hex 32
SHRI_WEB_CLIENT_SECRET=
