# Copy to infra/compose/.env (git-ignored) and fill in. Local development only.
POSTGRES_DB=shri_health
# Local superuser, standing in for the RDS master role. Never used by the API.
POSTGRES_USER=shri
POSTGRES_PASSWORD=
# One login per service role (DECISIONS D23).
SHRI_MIGRATOR_PASSWORD=
SHRI_APP_PASSWORD=
SHRI_FHIR_READER_PASSWORD=
SHRI_INTEGRATION_PASSWORD=
SHRI_REPORTING_PASSWORD=
SHRI_MAINTENANCE_PASSWORD=
SHRI_PORTAL_PASSWORD=
SHRI_PUBLIC_PASSWORD=
# OpenBao development server (compose only). Two different random values, for example:
# python3 -c "import uuid; print(uuid.uuid4())". The root token only sets up Transit; the API
# gets the narrow token, which can only encrypt and decrypt with one key.
OPENBAO_DEV_ROOT_TOKEN=
OPENBAO_API_TOKEN=
# Public forms (D96): keys the email rate limit's hash and signs the bot-check challenges. At
# least 32 characters, for example: openssl rand -hex 32
PUBLIC_FORM_SECRET=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# The API's Keycloak client secret (realm shri-staff, client shri-web). Any long random value,
# for example: openssl rand -hex 32
SHRI_WEB_CLIENT_SECRET=
# Keys the CSRF token of staff sessions. At least 32 characters: openssl rand -hex 32
SESSION_SECRET=
