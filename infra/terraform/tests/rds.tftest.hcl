# Plans against a mock AWS provider (no account or credentials needed), so CI can check that the
# controls ADR-0012 requires stay switched on. Run: tofu init -backend=false && tofu test

mock_provider "aws" {
  mock_data "aws_caller_identity" {
    defaults = { account_id = "123456789012" }
  }
  mock_data "aws_region" {
    defaults = { region = "us-east-1" }
  }
  mock_data "aws_iam_policy_document" {
    defaults = { json = "{\"Version\":\"2012-10-17\",\"Statement\":[]}" }
  }
  # OpenTofu's mocks fill computed attributes with random strings, which the provider's own ARN
  # validation then refuses; these are fixed, well-formed fakes in a fake account.
  mock_resource "aws_kms_key" {
    defaults = { arn = "arn:aws:kms:us-east-1:123456789012:key/00000000-0000-4000-8000-000000000001" }
  }
  mock_resource "aws_iam_role" {
    defaults = { arn = "arn:aws:iam::123456789012:role/shri-staging-rds-monitoring" }
  }
  mock_resource "aws_db_instance" {
    defaults = { arn = "arn:aws:rds:us-east-1:123456789012:db:shri-staging-postgres" }
  }
}

mock_provider "aws" {
  alias = "backup"

  mock_resource "aws_kms_key" {
    defaults = { arn = "arn:aws:kms:us-west-2:123456789012:key/00000000-0000-4000-8000-000000000002" }
  }
}

variables {
  environment            = "staging"
  vpc_id                 = "vpc-0123456789abcdef0"
  db_subnet_ids          = ["subnet-0aaaaaaaaaaaaaaa1", "subnet-0bbbbbbbbbbbbbbb2"]
  app_security_group_ids = ["sg-0ccccccccccccccc3"]
}

run "database_meets_adr_0012" {
  command = plan

  assert {
    condition     = aws_db_instance.postgres.engine == "postgres" && aws_db_instance.postgres.engine_version == "18"
    error_message = "PostgreSQL 18, latest minor release (D24)."
  }

  assert {
    condition     = aws_db_instance.postgres.auto_minor_version_upgrade && !aws_db_instance.postgres.allow_major_version_upgrade
    error_message = "Minor upgrades automatic; major upgrades only through a reviewed change."
  }

  assert {
    condition     = aws_db_instance.postgres.multi_az
    error_message = "Multi-AZ (ADR-0012)."
  }

  assert {
    condition     = aws_db_instance.postgres.storage_encrypted
    error_message = "Encrypted at rest with our KMS key (ADR-0012)."
  }

  assert {
    condition     = !aws_db_instance.postgres.publicly_accessible
    error_message = "The database is never reachable from the internet."
  }

  assert {
    condition     = aws_db_instance.postgres.deletion_protection && !aws_db_instance.postgres.skip_final_snapshot
    error_message = "Deletion protection on, and a final snapshot if it is ever deleted."
  }

  assert {
    condition     = aws_db_instance.postgres.manage_master_user_password && aws_db_instance.postgres.password == null
    error_message = "The master password is generated by RDS in Secrets Manager, never set in Terraform."
  }

  assert {
    condition     = aws_db_instance.postgres.backup_retention_period >= 7 && !aws_db_instance.postgres.delete_automated_backups
    error_message = "Automated backups with point-in-time recovery, kept if the instance is deleted."
  }

  assert {
    condition     = aws_db_instance_automated_backups_replication.postgres.retention_period == aws_db_instance.postgres.backup_retention_period
    error_message = "Backups are replicated to the second U.S. region for the same retention."
  }

  assert {
    condition     = aws_kms_key.database.enable_key_rotation && aws_kms_key.database_backup.enable_key_rotation
    error_message = "KMS keys rotate."
  }
}

run "tls_scram_and_no_phi_in_logs" {
  command = plan

  assert {
    condition = alltrue([
      for p in [
        { name = "rds.force_ssl", value = "1" },
        { name = "ssl_min_protocol_version", value = "TLSv1.2" },
        { name = "password_encryption", value = "scram-sha-256" },
        { name = "timezone", value = "UTC" },
        { name = "log_statement", value = "none" },
        { name = "log_parameter_max_length", value = "0" },
        { name = "log_parameter_max_length_on_error", value = "0" },
      ] : anytrue([for q in aws_db_parameter_group.postgres18.parameter : q.name == p.name && q.value == p.value])
    ])
    error_message = "TLS only, SCRAM, UTC, and no statements or bind values in server logs."
  }
}

run "only_listed_services_connect" {
  command = plan

  assert {
    condition     = length(aws_vpc_security_group_ingress_rule.postgres_from_services) == 1
    error_message = "One ingress rule per allowed service security group."
  }

  assert {
    condition     = alltrue([for r in aws_vpc_security_group_ingress_rule.postgres_from_services : r.from_port == 5432 && r.to_port == 5432 && r.cidr_ipv4 == null])
    error_message = "PostgreSQL port only, from security groups, never from an address range."
  }
}

run "regions_stay_in_the_united_states" {
  command = plan

  variables {
    backup_region = "eu-west-1"
  }

  expect_failures = [var.backup_region]
}

run "backup_region_differs_from_primary" {
  command = plan

  variables {
    backup_region = "us-east-1"
  }

  expect_failures = [var.backup_region]
}

run "multi_az_needs_two_subnets" {
  command = plan

  variables {
    db_subnet_ids = ["subnet-0aaaaaaaaaaaaaaa1"]
  }

  expect_failures = [var.db_subnet_ids]
}
