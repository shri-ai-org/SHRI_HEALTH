{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company-domain.invalid/contracts/partners/lab/lab-result.schema.json",
  "title": "LabResult",
  "description": "A lab or imaging result for one order (the HL7 v2 ORU^R01 equivalent, OBR and OBX, as JSON). Sent by the simulated center for the demo, later by the lab vendor's adapter (Q14), to /hooks/lab, whose receiver files it as a `DiagnosticReport` with its `Observation`s against the order and moves the order to `resulted`. A result for an unknown or cancelled order is refused and filed nowhere; a second result with the same `responseId` changes nothing; a `corrected` report amends the earlier one. x-phi marks each field's sensitivity as the API contract does (EXTENSIONS.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageType",
    "schemaVersion",
    "correlationId",
    "responseId",
    "respondedAt",
    "fillerOrderNumber",
    "category",
    "report"
  ],
  "properties": {
    "messageType": {
      "description": "Always `LabResult`.",
      "const": "LabResult",
      "x-phi": "none"
    },
    "schemaVersion": {
      "description": "This shape's version. A change that is not backward-compatible gets a new major version.",
      "const": "1.0",
      "x-phi": "none"
    },
    "correlationId": {
      "description": "Our order ID (HL7 v2 ORC-2 / OBR-2, placer order number). Every reply echoes it and is filed against it.",
      "$ref": "#/$defs/Id",
      "x-phi": "internal-id"
    },
    "responseId": {
      "description": "The center's ID for this message (MSH-10). Never a patient identifier.",
      "$ref": "#/$defs/PartnerId",
      "x-phi": "none"
    },
    "respondedAt": {
      "description": "When the center sent it, UTC.",
      "$ref": "#/$defs/Timestamp",
      "x-phi": "none"
    },
    "fillerOrderNumber": {
      "description": "The center's order number (ORC-3 / OBR-3), as in its acknowledgement.",
      "$ref": "#/$defs/PartnerId",
      "x-phi": "none"
    },
    "category": {
      "$ref": "#/$defs/Category",
      "x-phi": "none"
    },
    "report": {
      "description": "The report (OBR) and its results (OBX).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loinc",
        "name",
        "status",
        "issuedAt",
        "performerName",
        "results"
      ],
      "properties": {
        "loinc": {
          "$ref": "#/$defs/Loinc",
          "x-phi": "none"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-phi": "none"
        },
        "status": {
          "description": "OBR-25: `final` (F) or `corrected` (C).",
          "type": "string",
          "enum": [
            "final",
            "corrected"
          ],
          "x-phi": "none"
        },
        "collectedAt": {
          "description": "When the specimen was collected or the study done (OBR-7), UTC.",
          "$ref": "#/$defs/Timestamp",
          "x-phi": "clinical"
        },
        "issuedAt": {
          "description": "When the report was released (OBR-22), UTC.",
          "$ref": "#/$defs/Timestamp",
          "x-phi": "clinical"
        },
        "performerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-phi": "none"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "description": "One result (OBX): exactly one of `value` (a quantity) or `text` (a narrative, as for imaging).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "loinc",
              "name",
              "status"
            ],
            "properties": {
              "loinc": {
                "$ref": "#/$defs/Loinc",
                "x-phi": "none"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "x-phi": "none"
              },
              "value": {
                "description": "A UCUM quantity (OBX-5, OBX-6), the value as a decimal string.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "unit"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^-?[0-9]{1,9}(\\.[0-9]{1,6})?$",
                    "maxLength": 17,
                    "x-phi": "clinical"
                  },
                  "unit": {
                    "description": "UCUM unit.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "x-phi": "clinical"
                  }
                },
                "x-phi": "clinical"
              },
              "text": {
                "description": "A narrative result (OBX-5, type TX or FT).",
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "x-phi": "clinical"
              },
              "referenceRange": {
                "description": "OBX-7: `low` and/or `high` with their `unit`, or `text`.",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "low": {
                    "type": "string",
                    "pattern": "^-?[0-9]{1,9}(\\.[0-9]{1,6})?$",
                    "maxLength": 17,
                    "x-phi": "clinical"
                  },
                  "high": {
                    "type": "string",
                    "pattern": "^-?[0-9]{1,9}(\\.[0-9]{1,6})?$",
                    "maxLength": 17,
                    "x-phi": "clinical"
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "x-phi": "clinical"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "x-phi": "clinical"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "low"
                    ]
                  },
                  {
                    "required": [
                      "high"
                    ]
                  },
                  {
                    "required": [
                      "text"
                    ]
                  }
                ],
                "x-phi": "clinical"
              },
              "interpretation": {
                "description": "OBX-8 (HL7 v2 table 0078).",
                "type": "string",
                "enum": [
                  "H",
                  "L",
                  "N",
                  "A",
                  "HH",
                  "LL"
                ],
                "x-phi": "clinical"
              },
              "status": {
                "description": "OBX-11: `final` (F) or `corrected` (C).",
                "type": "string",
                "enum": [
                  "final",
                  "corrected"
                ],
                "x-phi": "none"
              }
            },
            "anyOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "text"
                ]
              }
            ],
            "not": {
              "required": [
                "value",
                "text"
              ]
            },
            "x-phi": "clinical"
          },
          "x-phi": "clinical"
        },
        "conclusion": {
          "description": "The report's impression or conclusion.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "x-phi": "clinical"
        }
      },
      "x-phi": "clinical"
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "Timestamp": {
      "description": "An instant, RFC 3339, UTC with Z.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "maxLength": 35
    },
    "PartnerId": {
      "description": "An identifier the lab or imaging center assigns. Never a patient identifier.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,60}$",
      "maxLength": 60
    },
    "Loinc": {
      "description": "A LOINC code.",
      "type": "string",
      "pattern": "^[0-9]{1,7}-[0-9]$",
      "maxLength": 9
    },
    "Category": {
      "description": "`laboratory` or `imaging` (US Core ServiceRequest / DiagnosticReport category).",
      "type": "string",
      "enum": [
        "laboratory",
        "imaging"
      ]
    }
  }
}
