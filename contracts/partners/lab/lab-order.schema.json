{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company-domain.invalid/contracts/partners/lab/lab-order.schema.json",
  "title": "LabOrder",
  "description": "A lab or imaging order for the performing lab or imaging center (the HL7 v2 ORM^O01 equivalent, ORC and OBR, as JSON): a new order (`orderControl` `NW`) for one signed order, or its cancel (`CA`). Built at send time by the lab adapter in the outbox worker from the order the outbox row names (the row holds only `{\"orderId\": …}`; `build_lab_order()` in backend/app/modules/orders), sent to the simulated lab and imaging center for the demo and, later, mapped to HL7 v2 over MLLP by the lab vendor's adapter (Q14). Minimum necessary: no SSN (D27, D43), no address, phone, insurance or MRN. x-phi marks each field's sensitivity as the API contract does (EXTENSIONS.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageType",
    "schemaVersion",
    "orderControl",
    "correlationId",
    "createdAt"
  ],
  "properties": {
    "messageType": {
      "description": "Always `LabOrder`.",
      "const": "LabOrder",
      "x-phi": "none"
    },
    "schemaVersion": {
      "description": "This shape's version. A change that is not backward-compatible gets a new major version.",
      "const": "1.0",
      "x-phi": "none"
    },
    "correlationId": {
      "description": "Our order ID (HL7 v2 ORC-2 / OBR-2, placer order number). Every reply echoes it and is filed against it.",
      "$ref": "#/$defs/Id",
      "x-phi": "internal-id"
    },
    "orderControl": {
      "description": "`NW` a new order, `CA` a request to cancel it (HL7 v2 ORC-1).",
      "type": "string",
      "enum": [
        "NW",
        "CA"
      ],
      "x-phi": "none"
    },
    "createdAt": {
      "description": "When the message was built (MSH-7), UTC.",
      "$ref": "#/$defs/Timestamp",
      "x-phi": "none"
    },
    "signedAt": {
      "description": "When the clinician signed the order (ORC-9), UTC. `NW` only.",
      "$ref": "#/$defs/Timestamp",
      "x-phi": "none"
    },
    "orderingProvider": {
      "description": "Who signed it (ORC-12 / OBR-16). `NW` only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npi",
        "name"
      ],
      "properties": {
        "npi": {
          "description": "The ordering clinician's NPI.",
          "type": "string",
          "pattern": "^[0-9]{10}$",
          "maxLength": 10,
          "x-phi": "none"
        },
        "name": {
          "$ref": "#/$defs/PersonName",
          "x-phi": "identifier"
        }
      },
      "x-phi": "identifier"
    },
    "patient": {
      "description": "Who the order is for (PID): enough for the center to match its own record and choose reference ranges, nothing more. `NW` only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "birthDate",
        "sex"
      ],
      "properties": {
        "name": {
          "description": "The patient's legal name, never a preferred or previous one.",
          "$ref": "#/$defs/PersonName",
          "x-phi": "identifier"
        },
        "birthDate": {
          "description": "Date of birth.",
          "$ref": "#/$defs/Date",
          "x-phi": "identifier"
        },
        "sex": {
          "description": "Administrative sex (PID-8), which the lab needs for its reference ranges (FHIR AdministrativeGender).",
          "type": "string",
          "enum": [
            "female",
            "male",
            "other",
            "unknown"
          ],
          "x-phi": "identifier"
        }
      },
      "x-phi": "identifier"
    },
    "performer": {
      "description": "The lab or imaging center the order goes to. `NW` only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name"
      ],
      "properties": {
        "code": {
          "description": "The center's code in our setup (its `lab_provider`).",
          "$ref": "#/$defs/PartnerId",
          "x-phi": "none"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-phi": "none"
        }
      },
      "x-phi": "none"
    },
    "category": {
      "description": "`NW` only.",
      "$ref": "#/$defs/Category",
      "x-phi": "none"
    },
    "test": {
      "description": "What is ordered (OBR-4), from the center's compendium. `NW` only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loinc",
        "name",
        "performerTestCode"
      ],
      "properties": {
        "loinc": {
          "$ref": "#/$defs/Loinc",
          "x-phi": "none"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-phi": "none"
        },
        "performerTestCode": {
          "description": "The center's own code for the test (its compendium entry).",
          "$ref": "#/$defs/PartnerId",
          "x-phi": "none"
        }
      },
      "x-phi": "clinical"
    },
    "priority": {
      "description": "HL7 v2 TQ1-9 / FHIR ServiceRequest.priority. `NW` only.",
      "type": "string",
      "enum": [
        "routine",
        "urgent",
        "asap",
        "stat"
      ],
      "x-phi": "clinical"
    },
    "diagnosisCodes": {
      "description": "The visit's ICD-10-CM codes, for medical necessity (DG1), at most 4. `NW` only, optional.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][0-9][0-9A-Z](\\.[0-9A-Z]{1,4})?$",
        "maxLength": 8
      },
      "x-phi": "clinical"
    },
    "noteToPerformer": {
      "description": "The clinician's note to the center (NTE). `NW` only, optional.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "x-phi": "clinical"
    },
    "fillerOrderNumber": {
      "description": "The center's order number (ORC-3), from its acknowledgement. `CA` only, when the center has already acknowledged the order.",
      "$ref": "#/$defs/PartnerId",
      "x-phi": "none"
    },
    "cancelReason": {
      "description": "Why the order is cancelled (ORC-16). `CA` only.",
      "type": "string",
      "minLength": 3,
      "maxLength": 500,
      "x-phi": "clinical"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "orderControl"
        ],
        "properties": {
          "orderControl": {
            "const": "NW"
          }
        }
      },
      "then": {
        "required": [
          "signedAt",
          "orderingProvider",
          "patient",
          "performer",
          "category",
          "test",
          "priority"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "cancelReason"
              ]
            },
            {
              "required": [
                "fillerOrderNumber"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "orderControl"
        ],
        "properties": {
          "orderControl": {
            "const": "CA"
          }
        }
      },
      "then": {
        "required": [
          "cancelReason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "signedAt"
              ]
            },
            {
              "required": [
                "orderingProvider"
              ]
            },
            {
              "required": [
                "patient"
              ]
            },
            {
              "required": [
                "performer"
              ]
            },
            {
              "required": [
                "category"
              ]
            },
            {
              "required": [
                "test"
              ]
            },
            {
              "required": [
                "priority"
              ]
            },
            {
              "required": [
                "diagnosisCodes"
              ]
            },
            {
              "required": [
                "noteToPerformer"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "Date": {
      "description": "A calendar date, YYYY-MM-DD.",
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "maxLength": 10
    },
    "Timestamp": {
      "description": "An instant, RFC 3339, UTC with Z.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "maxLength": 35
    },
    "PersonName": {
      "description": "A person's legal name (HL7 v2 XPN / XCN family and given names).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "x-phi": "identifier"
        },
        "given": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "x-phi": "identifier"
        }
      }
    },
    "Loinc": {
      "description": "A LOINC code.",
      "type": "string",
      "pattern": "^[0-9]{1,7}-[0-9]$",
      "maxLength": 9
    },
    "PartnerId": {
      "description": "An identifier the lab or imaging center assigns. Never a patient identifier.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,60}$",
      "maxLength": 60
    },
    "Category": {
      "description": "`laboratory` or `imaging` (US Core ServiceRequest / DiagnosticReport category).",
      "type": "string",
      "enum": [
        "laboratory",
        "imaging"
      ]
    }
  }
}
