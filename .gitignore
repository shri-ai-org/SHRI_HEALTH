# Shri Health — what the repository (and so every deployment) leaves out.
# The app is doctors-portal/: its source, scripts, public assets and config.

# Documents and design specs — kept on disk, never committed or deployed.
*.md

# Dependencies and build output — `npm ci` and `npm run build` recreate them.
node_modules/
dist/
dist-ssr/
.vite/
*.local
*.tsbuildinfo

# Source imaging: the CT DICOMs that the PNG slices in public/ncct/ were
# exported from (scripts/ncct-import.mjs), and design screenshots.
*.dcm
UI.png
# The raw downloads scripts/imaging-import.mjs converts; the frames it writes are committed.
doctors-portal/imaging-src/

# The speech service (backend/): its virtualenv and Python caches are rebuilt from
# requirements.txt; the evaluation audio (FLEURS) is downloaded, not committed; the
# models live in the Hugging Face cache, outside the repo.
backend/.venv/
backend-data/
__pycache__/
*.pyc

# Secrets and environment files.
.env
.env.*
!.env.example
*.pem

# Tool and assistant scratch.
.claude/
.playwright-mcp/
coverage/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and operating systems.
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.sw?

# Teleconsult transcripts the speech service stores (backend/telehealth) — patient data, never committed.
backend/data/
